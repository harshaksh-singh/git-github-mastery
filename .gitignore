# rebuildable or local-only
video/production/.cache/
video/production/slides/
video/production/anim/
video/production/out/*.mp4
tools/.labroot/
__pycache__/
*.pyc
.DS_Store
video/production/recordings/

# YouTube publishing: run-time files, and a guard in case a secret is ever
# saved here by mistake (secrets belong in ~/.config/git-mastery-youtube/)
video/youtube/.lock
video/youtube/logs/
video/youtube/*.tmp*
video/youtube/client_secret*.json
video/youtube/token*.json
video/youtube/sessions*.json
client_secret*.json
